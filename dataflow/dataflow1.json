{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID as string,",
				"          {Movie Name} as string,",
				"          Year as string,",
				"          {Timing(min)} as string,",
				"          {Rating(10)} as string,",
				"          Votes as string,",
				"          Genre as string,",
				"          Language as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          ID,",
				"          {Movie Name},",
				"          Year,",
				"          {Run Time} = {Timing(min)},",
				"          Rating = {Rating(10)},",
				"          Votes,",
				"          Genre,",
				"          Language",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 filter(and(and(ID != '-', {Run Time} != '-'),and(Rating != '-',Genre != '-'))) ~> filter1",
				"filter1 derive(Language = upper(substring(Language,1,1))  +  substring(Language,2),",
				"          Year = regexReplace(Year, '[^[0-9]]', '')) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     input(",
				"          ID as string,",
				"          {Movie Name} as string,",
				"          Year as string,",
				"          {Timing(min)} as string,",
				"          {Rating(10)} as string,",
				"          Votes as string,",
				"          Genre as string,",
				"          Language as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}